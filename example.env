# Copy to .env and edit (.env is gitignored).

INKWELL_INPUT_DIR="$HOME/records"
INKWELL_OUTPUT_DIR="$HOME/records-scrubbed"
# The key folder links pseudonyms to people. Keep it outside the output; destroy it to make the output non-reidentifiable.
INKWELL_KEY_FILE="$HOME/Documents/inkwell-key/key.csv"

# Docker (scripts/docker-run.sh): host folders mounted into the container
HOST_INPUT_DIR="$HOME/records"
HOST_OUTPUT_DIR="$HOME/records-scrubbed"
HOST_KEY_DIR="$HOME/Documents/inkwell-key"

# Tuning (optional)
INKWELL_WORKERS=8                 # about 1 GB of memory each
INKWELL_DPI=300                   # PDF render/OCR resolution
INKWELL_JPEG_QUALITY=70
INKWELL_SCORE_THRESHOLD=0.35      # minimum detection confidence
INKWELL_WITHHOLD_THRESHOLD=3      # classifier score that withholds a document
# INKWELL_ENTITIES=PERSON,US_SSN  # restrict entity types (default: all)

# Site conventions (optional)
# INKWELL_GROUP_DIR_REGEX='^Cohort (\d{4}-\d{2})$'   # top-level folders that keep their names
# INKWELL_EXTRA_ID_LABELS=XUID,Banner ID              # labels that precede an ID
# INKWELL_EXTRA_NAME_NOISE=msc,ba                     # folder-name words that are not names

# Permitted names and places (optional; see README)
# INKWELL_PERMITTED_NAMES_FILE="$HOME/Documents/inkwell-key/permitted.csv"   # name,aliases,emails,phones
# INKWELL_PERMITTED_CONTACTS=false                                           # also keep their emails/phones
# INKWELL_PERMITTED_PLACES_FILE="$HOME/Documents/inkwell-key/places.csv"     # place,aliases
