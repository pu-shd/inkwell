# Copy to .env and edit. .env is gitignored.

# --- native runs (scripts/run.sh) ---
INKWELL_INPUT_DIR="$HOME/records"
INKWELL_OUTPUT_DIR="$HOME/records-scrubbed"
# Maps pseudonyms (S-7KQ2M9XHC) back to real names, with registry.csv beside it. Keep it OUTSIDE the output folder;
# store it encrypted or destroy it if re-identification must be impossible.
INKWELL_KEY_FILE="$HOME/Documents/inkwell-key/key.csv"

# --- docker-compose runs: host paths mounted into the container ---
HOST_INPUT_DIR="$HOME/records"
HOST_OUTPUT_DIR="$HOME/records-scrubbed"
HOST_KEY_DIR="$HOME/Documents/inkwell-key"

# --- tuning (all optional) ---
INKWELL_WORKERS=8                 # each worker holds ~1 GB (spaCy model)
INKWELL_DPI=300                   # render/OCR resolution for PDF pages
INKWELL_JPEG_QUALITY=70
INKWELL_SCORE_THRESHOLD=0.35      # Presidio minimum confidence
INKWELL_WITHHOLD_THRESHOLD=3      # classifier score at which a whole document is withheld
# INKWELL_ENTITIES=PERSON,US_SSN,...   # restrict entity types (default: all)

# --- institution-specific conventions (optional) ---
# INKWELL_GROUP_DIR_REGEX='^Cohort (\d{4}-\d{2})$'   # default: folder names ending in e.g. 2019-20
# INKWELL_EXTRA_ID_LABELS=XUID,Banner ID              # labels that precede an ID number
# INKWELL_EXTRA_NAME_NOISE=msc,ba                     # folder-name words that are not names

# --- permitted names (optional): people whose full names stay visible ---
# INKWELL_PERMITTED_NAMES_FILE="$HOME/Documents/inkwell-key/permitted.csv"   # name,aliases,emails,phones
# INKWELL_PERMITTED_CONTACTS=false                                         # also keep their listed contacts
# INKWELL_PERMITTED_PLACES_FILE="$HOME/Documents/inkwell-key/places.csv"  # place,aliases
